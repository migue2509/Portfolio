---
import "@fontsource-variable/geist/wght.css";
import "@fontsource-variable/geist-mono/wght.css";
import Header from "../shared/layout/Header.astro";
import CommitIntro from "../features/intro/CommitIntro.astro";
import favicon from "../assets/profile/icon.png";
import "../shared/styles/global.css";

interface Props {
  title: string;
  description: string;
  intro?: boolean;
  showHeader?: boolean;
}

const { title, description, intro = false, showHeader = true } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
     <!-- Google Tag Manager -->
<script is:inline>
  (function(w,d,s,l,i){
    w[l]=w[l]||[];
    w[l].push({
      'gtm.start': new Date().getTime(),
      event:'gtm.js'
    });

    var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),
        dl=l!='dataLayer'?'&l='+l:'';

    j.async=true;
    j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;

    f.parentNode.insertBefore(j,f);

  })(window,document,'script','dataLayer','GTM-5HF4DZBV');
</script>

<!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={favicon.src} />
    <title>{title}</title>
    
    {intro && <script is:inline>
      (() => {
        try {
          // Un enlace a una sección debe abrir directamente su destino.
          if (window.location.hash) return;
          if (matchMedia('(prefers-reduced-motion: reduce)').matches || sessionStorage.getItem('portfolio:intro-seen')) return;
          sessionStorage.setItem('portfolio:intro-seen', '1');
          document.documentElement.classList.add('intro-pending');
          const release = () => {
            clearTimeout(fallback);
            document.removeEventListener('intro:mounted', release);
          };
          const fallback = setTimeout(() => {
            release();
            document.documentElement.classList.remove('intro-pending');
          }, 4000);
          document.addEventListener('intro:mounted', release, { once: true });
        } catch { /* Si el almacenamiento está bloqueado, mostramos el sitio directamente. */ }
      })();
    </script>}
    <style is:global>
      html.intro-pending { overflow: hidden; }
      html.intro-pending::before { content: ''; position: fixed; inset: 0; z-index: 9999; background: #000; pointer-events: none; }
      html.intro-pending:has(dialog[open])::before { display: none; }
    </style>
  </head>

 <body class="site-body">
  <!-- Google Tag Manager (noscript) -->
<noscript>
  <iframe
    src="https://www.googletagmanager.com/ns.html?id=GTM-5HF4DZBV"
    height="0"
    width="0"
    style="display:none;visibility:hidden"
  ></iframe>
</noscript>
<!-- End Google Tag Manager (noscript) -->
  {intro && <CommitIntro />}
  {showHeader && <Header />}
  <slot />
</body>
</html>

<script>
  import { initializeSmoothScroll, destroySmoothScroll } from '../shared/scripts/smooth-scroll';
  initializeSmoothScroll();
  document.addEventListener('astro:page-load', initializeSmoothScroll);
  document.addEventListener('astro:before-swap', destroySmoothScroll);
  if (import.meta.hot) import.meta.hot.dispose(() => {
    destroySmoothScroll();
    document.removeEventListener('astro:page-load', initializeSmoothScroll);
    document.removeEventListener('astro:before-swap', destroySmoothScroll);
  });
</script>

<style>
  .site-body {
    --page-gutter: 0px;
    padding-inline: var(--page-gutter);
  }

  @media (min-width: 64rem) {
    .site-body {
      --page-gutter: 3.5rem;
    }
  }
</style>
