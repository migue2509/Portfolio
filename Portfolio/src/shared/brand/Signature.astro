---
import { Image } from "astro:assets";
import signature from "../../assets/brand/signature.png";
---

<Image
  src={signature}
  alt="Firma de Miguel Ospina"
  class="signature"
  widths={[144, 288, signature.width]}
  sizes="144px"
  loading="eager"
/>

<style>
  .signature {
    display: block;
    width: 9rem;
    height: 3.5rem;
    object-fit: cover;
    object-position: center 51%;
  }
</style>
