---
import SocialLinks from "../brand/SocialLinks.astro";
---

<nav class="social-rail" aria-label="Enlaces sociales">
  <span class="social-rail__line" aria-hidden="true"></span>
  <div class="social-rail__links">
    <SocialLinks />
  </div>
  <span class="social-rail__trail" aria-hidden="true"></span>
</nav>

<style>
  .social-rail {
    display: flex;
    align-items: center;
    width: max-content;
    max-width: calc(100% - 2rem);
    margin: 1.5rem auto 0;
  }

  .social-rail__links {
    padding: 0.125rem;
    border: 1px solid rgb(255 255 255 / 16%);
    border-radius: 999px;
    background: rgb(45 45 48 / 95%);
    box-shadow: 0 4px 16px rgb(0 0 0 / 25%);
  }

  .social-rail :global(.social-links) {
    flex-wrap: nowrap;
    gap: 0;
  }

  .social-rail :global(.social-links__link) {
    border: 1px solid transparent;
    border-radius: 50%;
    background: transparent;
  }

  .social-rail :global(.social-links__link:hover),
  .social-rail :global(.social-links__link:focus-visible) {
    border-color: var(--color-accent);
    background: rgb(147 197 253 / 15%);
  }

  .social-rail :global(.social-links__link:focus-visible) {
    outline-offset: -3px;
  }

  .social-rail__line,
  .social-rail__trail {
    display: none;
    pointer-events: none;
  }

  @media (min-width: 64rem) {
    .social-rail {
      position: absolute;
      top: 1rem;
      bottom: 1rem;
      left: calc(-1 * var(--page-gutter, 3.5rem) + 0.375rem);
      margin: 0;
      flex-direction: column;
      width: 2.875rem;
    }

    .social-rail__links {
      flex-shrink: 0;
    }

    .social-rail :global(.social-links) {
      flex-direction: column;
    }

    .social-rail__line {
      position: relative;
      display: block;
      flex: 0 0 42%;
      width: 2px;
      background: var(--color-accent);
    }

    .social-rail__line::before {
      content: "";
      position: absolute;
      top: 0;
      left: 50%;
      width: 0.875rem;
      height: 0.875rem;
      border-radius: 50%;
      background: var(--color-accent);
      transform: translate(-50%, -50%);
    }

    .social-rail__trail {
      display: block;
      flex: 1;
      width: 0;
      min-height: 0;
      border-left: 2px dotted rgb(147 197 253 / 50%);
      mask-image: linear-gradient(#000 60%, transparent);
    }
  }
</style>
