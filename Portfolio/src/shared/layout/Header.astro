---
import Container from "./Container.astro";
import Signature from "../brand/Signature.astro";
---

<header class="header">
  <Container>
    <div class="header__bar">
      <a
        href="/"
        class="header__brand"
        aria-label="Miguel Ospina, ir al inicio"
      >
        <Signature />
      </a>

      <nav class="header__nav" aria-label="Navegación principal">
  <a href="/" class="header__link">
    Inicio
  </a>

  <a href="/#sobre-mi" class="header__link">
    Sobre mí
  </a>
</nav>
    </div>
  </Container>
</header>

<style>
  .header {
    padding-top: var(--space-6);
  }

  .header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);

    min-height: 4rem;
    padding: var(--space-2) var(--space-4);

    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: 999px;
  }

  .header__brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;

    min-height: 2.75rem;
    border-radius: var(--radius-small);
  }

  .header__link {
    display: inline-flex;
    align-items: center;

    min-height: 2.75rem;
    padding-inline: var(--space-4);

    color: var(--color-text-muted);
    font-size: 0.875rem;
    text-decoration: none;
    border-radius: var(--radius-small);
  }

  .header__link:hover,
  .header__link:focus-visible {
    color: var(--color-accent);
  }

  .header__nav {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  align-items: center;
  min-width: 0;
}
</style>