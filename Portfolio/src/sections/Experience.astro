---
import Container from "../shared/layout/Container.astro";
import { experiences, type Experience } from "../data/experience";

const entries: readonly Experience[] = experiences;
---

<section id="experiencia" class="experience" aria-labelledby="experience-title" data-experience>
  <Container>
    <div class="experience__frame">
      <h2 id="experience-title" class="experience__label">Experiencia</h2>

      <div class="experience__timeline" data-experience-timeline>
        <span class="experience__track" aria-hidden="true">
          <span class="experience__progress" data-experience-progress></span>
        </span>

        <ol class="experience__list" role="list">
          {entries.map((entry) => (
            <li class="experience__entry" data-experience-entry>
              <div class="experience__date" data-experience-date>
                <span class="experience__year" aria-hidden="true">{entry.year}</span>
                <span class="experience__period">
                  <time datetime={entry.start}>{entry.startLabel}</time>
                  <span aria-hidden="true"> — </span>
                  {entry.end ? <time datetime={entry.end}>{entry.endLabel}</time> : <span>{entry.endLabel}</span>}
                </span>
              </div>

              <span class="experience__dot" aria-hidden="true" data-experience-dot></span>

              <article class="experience__card" aria-labelledby={`experience-${entry.id}`} data-experience-card>
                <div class="experience__overview">
                  <div class="experience__identity">
                    <span class="experience__monogram" aria-hidden="true">{entry.initials}</span>
                    <div>
                      <h3 id={`experience-${entry.id}`} class="experience__role">{entry.role}</h3>
                      <p class="experience__company">{entry.company}</p>
                    </div>
                  </div>
                  <ul class="experience__technologies" aria-label="Tecnologías y herramientas" role="list">
                    {entry.technologies.map((technology) => <li>{technology}</li>)}
                  </ul>
                </div>

                <div class="experience__impact">
                  <h4>Impacto</h4>
                  <ul role="list">
                    {entry.impact.map((achievement) => (
                      <li>
                        <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                          <circle cx="10" cy="10" r="7" />
                          <path d="m6.5 10 2.3 2.3 4.7-4.7" />
                        </svg>
                        <span>{achievement}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </article>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </Container>
</section>

<script>
  import { initializeExperience } from "../features/experience/experience-animation";
  initializeExperience();
  document.addEventListener("astro:page-load", initializeExperience);
</script>

<style>
  .experience {
    padding-block: var(--space-12);
    scroll-margin-top: 7rem;
  }

  .experience__frame {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    background: #080808;
    box-shadow: inset 0 0 0 4px rgb(255 255 255 / 2%);
  }

  .experience__label {
    display: table;
    margin: 0;
    padding: var(--space-3) var(--space-6);
    border-top-left-radius: calc(var(--radius-medium) - 1px);
    background: #d4d4d8;
    color: #18181b;
    font: 600 0.875rem var(--font-mono);
    line-height: 1.6;
    text-transform: uppercase;
  }

  .experience__timeline {
    position: relative;
    margin: 2rem 1rem;
  }

  .experience__track {
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: 0.375rem;
    width: 2px;
    background: rgb(147 197 253 / 15%);
  }

  .experience__progress {
    display: block;
    width: 100%;
    height: 100%;
    transform-origin: center top;
    background: var(--color-accent);
    box-shadow: 0 0 10px rgb(147 197 253 / 20%);
  }

  .experience__list {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .experience__entry {
    position: relative;
    display: grid;
    gap: 0.875rem;
    padding-left: 1.75rem;
    min-width: 0;
  }

  .experience__date {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    padding-top: 0.125rem;
  }

  .experience__year {
    color: var(--color-text);
    font: 800 1.125rem var(--font-mono);
    line-height: 1.4;
  }

  .experience__period {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .experience__dot {
    position: absolute;
    top: 0.5rem;
    left: 0.375rem;
    width: 0.875rem;
    height: 0.875rem;
    margin-left: -0.375rem;
    border: 2px solid var(--color-accent);
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 5px #080808;
  }

  .experience__card {
    display: grid;
    gap: 1.25rem;
    min-width: 0;
    padding: clamp(1rem, 2vw, 1.5rem);
    border: 1px solid rgb(255 255 255 / 6%);
    border-radius: 0.75rem;
    background-color: #18181b;
    background-image: linear-gradient(135deg, rgb(255 255 255 / 3%), transparent 65%);
    box-shadow: 0 8px 24px rgb(0 0 0 / 18%);
  }

  .experience__identity {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
  }

  .experience__identity > div {
    min-width: 0;
  }

  .experience__monogram {
    display: grid;
    place-items: center;
    flex: 0 0 2.75rem;
    height: 2.75rem;
    border: 1px solid rgb(147 197 253 / 25%);
    border-radius: 0.5rem;
    background: rgb(147 197 253 / 10%);
    color: var(--color-accent);
    font: 700 1rem var(--font-mono);
  }

  .experience__role {
    margin: 0;
    color: var(--color-text);
    font: 700 clamp(1rem, 1.6vw, 1.25rem) var(--font-mono);
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .experience__company {
    margin: 0.375rem 0 0;
    color: var(--color-text-muted);
    font: 0.875rem var(--font-mono);
    line-height: 1.5;
  }

  .experience__technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .experience__technologies li {
    max-width: 100%;
    padding: 0.3rem 0.75rem;
    border: 1px solid rgb(192 132 252 / 15%);
    border-radius: 999px;
    background: #341750;
    color: #d8b4fe;
    font: 0.6875rem var(--font-mono);
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .experience__impact {
    min-width: 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .experience__impact h4 {
    margin: 0 0 0.75rem;
    font: 700 0.9375rem var(--font-mono);
  }

  .experience__impact ul {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .experience__impact li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    color: #c4c4cc;
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .experience__impact svg {
    flex: 0 0 1rem;
    margin-top: 0.2rem;
    color: var(--color-accent);
  }

  @media (min-width: 48rem) {
    .experience__timeline { margin: 2rem; }
    .experience__track { left: 7.75rem; }
    .experience__entry {
      grid-template-columns: 6.25rem minmax(0, 1fr);
      gap: 3rem;
      padding-left: 0;
    }
    .experience__dot { left: 7.75rem; }
  }

  @media (min-width: 75rem) {
    .experience__card {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .experience__impact {
      padding-top: 0;
      padding-left: 1.25rem;
      border-top: 0;
      border-left: 1px solid var(--color-border);
    }
  }
</style>
