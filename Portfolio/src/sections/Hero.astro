---
import { Image } from "astro:assets";
import Container from "../shared/layout/Container.astro";
import SocialRail from "../shared/layout/SocialRail.astro";
import portrait from "../assets/profile/Image.png";
import { existsSync } from "node:fs";

interface Props {
  cvUrl?: string;
}

const localCvExists = existsSync("public/documents/miguel-ospina-cv.pdf");
const { cvUrl = localCvExists ? "/documents/miguel-ospina-cv.pdf" : undefined } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <Container>
    <div class="hero__layout">
      <div class="hero__portrait">
        <Image
          src={portrait}
          alt="Retrato ilustrado de Miguel Ospina, con notas de enfoque, resiliencia y mentalidad de crecimiento"
          class="hero__image"
          widths={[288, 576, portrait.width]}
          sizes="(min-width: 48rem) 288px, (min-width: 22rem) 288px, calc(100vw - 2rem)"
          format="webp"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="hero__content">
        <p class="hero__role">{"Desarrollador <Full Stack/>"}</p>

        <h1 id="hero-title" class="hero__title" aria-label="Soy Migue">
          Soy <span class="hero__name" aria-hidden="true">{"Migue".split("").map((letter) => (
            <span class="hero__letter">{letter}</span>
          ))}</span>
        </h1>

        <p class="hero__description">
          <span>Transformo necesidades reales en soluciones de software, combinando criterio técnico, aprendizaje continuo y foco en generar valor.</span>
        </p>

        <div class="hero__actions">
          {cvUrl ? (
            <a class="hero__cv grain-surface" href={cvUrl} download="miguel-ospina-cv.pdf" data-cv-download>
              <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
                <path d="M7 1h2v7l2-2 1.4 1.4L8 11.8 3.6 7.4 5 6l2 2V1ZM3 13h10v2H3v-2Z" />
              </svg>
              Descargar CV
            </a>
          ) : (
            <button class="hero__cv grain-surface" type="button" disabled title="CV próximamente" aria-label="Descargar CV, próximamente">
              <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
                <path d="M7 1h2v7l2-2 1.4 1.4L8 11.8 3.6 7.4 5 6l2 2V1ZM3 13h10v2H3v-2Z" />
              </svg>
              Descargar CV
            </button>
          )}
        </div>
      </div>
    </div>
  </Container>
  <SocialRail />
  <p class="hero__download-notice" role="status" aria-live="polite" aria-atomic="true" data-cv-notice></p>
</section>

<script>
  import { gsap } from "gsap";

  const initialized = new WeakSet<HTMLElement>();
  function initializeDownloadNotice() {
    const link = document.querySelector<HTMLAnchorElement>("[data-cv-download]");
    const notice = document.querySelector<HTMLElement>("[data-cv-notice]");
    if (!link || !notice || initialized.has(link)) return;
    initialized.add(link);
    let timer = 0;
    const events = new AbortController();
    link.addEventListener("click", (event) => {
      if (event.defaultPrevented || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      // Conservamos la descarga nativa; no podemos detectar el guardado final.
      notice.textContent = "Descarga iniciada. Revisa las descargas de tu navegador.";
      window.clearTimeout(timer);
      timer = window.setTimeout(() => { notice.textContent = ""; }, 6000);
    }, { signal: events.signal });
    document.addEventListener("astro:before-swap", () => {
      events.abort();
      window.clearTimeout(timer);
      notice.textContent = "";
      initialized.delete(link);
    }, { once: true, signal: events.signal });
  }
  function initializeTyping() {
    const name = document.querySelector<HTMLElement>(".hero__name");
    if (!name || initialized.has(name)) return;
    initialized.add(name);
    const media = gsap.matchMedia();
    media.add("(prefers-reduced-motion: no-preference)", () => {
      const letters = name.querySelectorAll<HTMLElement>(".hero__letter");
      const timeline = gsap.timeline({ paused: true, repeat: -1 });
      timeline
        .set(letters, { opacity: 0 })
        .to(letters, { opacity: 1, duration: 0, stagger: 0.25 }, 0.65)
        .to({}, { duration: 3 })
        .to(letters, { opacity: 0, duration: 0, stagger: { each: 0.12, from: "end" } })
        .to({}, { duration: 0.65 });

      const observer = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) timeline.play();
        else timeline.pause();
      }, { threshold: 0.5 });
      observer.observe(name);
      return () => observer.disconnect();
    });
    document.addEventListener("astro:before-swap", () => {
      media.revert();
      initialized.delete(name);
    }, { once: true });
  }
  initializeTyping();
  initializeDownloadNotice();
  document.addEventListener("astro:page-load", initializeTyping);
  document.addEventListener("astro:page-load", initializeDownloadNotice);
</script>

<style>
  .hero {
    position: relative;
    padding-block: clamp(1.5rem, 3vw, 2rem) var(--space-6);
  }

  .hero__layout {
    display: grid;
    align-items: center;
    gap: 1.75rem;
    max-width: 60rem;
    margin-inline: auto;
  }

  .hero__portrait {
    width: 100%;
    max-width: 18rem;
    justify-self: center;
  }

  .hero__image {
    display: block;
    width: 100%;
    height: auto;
    /* El archivo ya contiene los marcos: no recortamos sus bordes. */
  }

  .hero__content {
    min-width: 0;
    text-align: center;
  }

  .hero__role {
    display: inline-block;
    max-width: 100%;
    margin: 0 0 0.75rem;
    padding: 0.4rem 0.875rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: rgb(8 8 8 / 25%);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 3%);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: clamp(0.75rem, 1.6vw, 1rem);
    font-weight: 500;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .hero__title {
    margin: 0;
    color: var(--color-text);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.5rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .hero__title span {
    color: var(--color-accent);
  }

  .hero__name {
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }

  .hero__description {
    max-width: 62ch;
    margin: 0.75rem auto 0;
    color: var(--color-text-muted);
    font-size: clamp(0.875rem, 1.5vw, 1rem);
    line-height: 1.45;
    text-wrap: pretty;
  }

  .hero__description span {
    display: block;
  }

  .hero__actions {
    display: flex;
    justify-content: center;
    margin-top: 1.375rem;
  }

  .hero__cv {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid #a1a1aa;
    border-radius: 0.125rem;
    background: #e4e4e7;
    color: #18181b;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
  }

  .hero__cv svg {
    flex-shrink: 0;
  }

  .hero__cv:disabled {
    cursor: not-allowed;
    opacity: 0.75;
  }

  a.hero__cv:hover {
    background: #fafafa;
  }

  .hero__cv:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .hero__download-notice {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 50;
    width: max-content;
    max-width: min(24rem, calc(100vw - 2rem));
    margin: 0;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-small);
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: 0 8px 28px rgb(0 0 0 / 30%);
    font-size: 0.875rem;
    line-height: 1.5;
    pointer-events: none;
  }

  .hero__download-notice:empty {
    opacity: 0;
  }

  @media (min-width: 48rem) {
    .hero__layout {
      grid-template-columns: 18rem minmax(0, 1fr);
      gap: clamp(1.5rem, 3vw, 2rem);
    }

    .hero__portrait {
      justify-self: start;
    }

    .hero__content {
      text-align: left;
    }

    .hero__description {
      margin-inline: 0;
    }

    .hero__actions {
      justify-content: flex-start;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__download-notice {
      transition: opacity 180ms ease;
    }

    .hero__name::after {
      content: "";
      position: absolute;
      top: 0.18em;
      right: -0.12em;
      width: 2px;
      height: 0.8em;
      background: var(--color-accent);
      animation: hero-caret 650ms step-end infinite;
    }

    a.hero__cv {
      transition: background-color 160ms ease;
    }
  }

  @keyframes hero-caret {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }
</style>
