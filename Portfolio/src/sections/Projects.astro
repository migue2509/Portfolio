---
import Container from "../shared/layout/Container.astro";
import ProjectGallery from "../features/projects/ProjectGallery.astro";
import { projects } from "../data/projects";
import githubIcon from "../assets/brand/github-mark.svg?url";
---

<section
  id="proyectos"
  class="projects"
  aria-labelledby="projects-title"
>
  <Container>
    <div class="projects__frame">
      <h2 id="projects-title" class="projects__label">
        Proyectos
      </h2>

      <ProjectGallery projects={projects} />

      <footer class="projects__footer">
        <a
          class="projects__github"
          href="https://github.com/migue2509"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img
            src={githubIcon}
            alt=""
            width="18"
            height="18"
            class="projects__github-icon"
          />

          <span>Ver todos los proyectos en GitHub</span>

          <span class="projects__sr-only">
            (abre en una pestaña nueva)
          </span>
        </a>
      </footer>
    </div>
  </Container>
</section>

<style>
  .projects {
    padding-block: var(--space-12);
    scroll-margin-top: var(--space-8);
  }

  .projects__frame {
    min-width: 0;
    overflow: hidden;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);

    background-color: #080808;
    background-image:
      linear-gradient(
        rgb(255 255 255 / 2%) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgb(255 255 255 / 2%) 1px,
        transparent 1px
      );
    background-size: 2rem 2rem;
  }

  .projects__label {
    display: table;
    margin: 0;
    padding: var(--space-3) var(--space-6);

    background-color: #d4d4d8;
    color: #18181b;

    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .projects__footer {
    display: flex;
    justify-content: center;
    padding: var(--space-6) var(--space-4);

    border-top: 1px solid var(--color-border);
    background-color: #080808;
  }

  .projects__github {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);

    max-width: 100%;
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-3);

    border: 1px solid #292929;
    border-radius: 999px;
    background: linear-gradient(180deg, #242424, #151515);
    color: #fafafa;

    font-family: var(--font-mono);
    font-size: clamp(0.75rem, 0.7rem + 0.2vw, 0.875rem);
    line-height: 1.5;
    text-align: center;
    text-decoration: none;
  }

  .projects__github::before,
  .projects__github::after {
    content: "";
    flex: 0 0 clamp(0.75rem, 2vw, 1.75rem);
    height: 1px;
    background-color: #d4d4d4;
  }

  .projects__github-icon {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  .projects__github:hover {
    border-color: #71717a;
  }

  .projects__github:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .projects__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: no-preference) {
    .projects__github {
      transition: transform 180ms ease;
    }

    .projects__github:hover {
      transform: translateY(-2px);
    }
  }
</style>