---
import Container from "../shared/layout/Container.astro";
import AboutDetails from "../features/about/AboutDetails.astro";
import ProfileCard from "../features/about/ProfileCard.astro";
import StackStrip from "../features/about/StackStrip.astro";
---

<section id="sobre-mi" class="about" aria-labelledby="about-title">
  <Container>
    <div class="about__frame">
      <h2 id="about-title" class="about__label">
        Sobre mí
      </h2>

      <div class="about__columns">
        <AboutDetails />
        <ProfileCard />
      </div>
      <StackStrip />

    </div>
  </Container>
</section>

<style>
  .about {
    padding-block: var(--space-12);
    scroll-margin-top: var(--space-8);
  }

  .about__frame {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    background-color: var(--color-background);

    background-image:
      linear-gradient(
        rgb(255 255 255 / 3%) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgb(255 255 255 / 3%) 1px,
        transparent 1px
      );

    background-size: 2rem 2rem;
  }

  .about__label {
    display: table;
    margin: 0;
    padding: var(--space-2) var(--space-6);

    border-top-left-radius: calc(var(--radius-medium) - 1px);
    background-color: #d4d4d8;
    color: var(--color-background);

    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .about__columns {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-6);
    align-items: stretch;
  }

  @media (min-width: 64rem) {
    .about__columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>