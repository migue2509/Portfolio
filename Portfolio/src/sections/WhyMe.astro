---
import Container from "../shared/layout/Container.astro";
import { approachSteps } from "../data/approach";
---

<section id="por-que-elegirme" class="why" aria-labelledby="why-title">
  <Container>
    <div class="why__frame">
      <h2 id="why-title" class="why__label grain-surface">¿Por qué elegirme?</h2>

      <header class="why__intro">
        <p class="why__eyebrow">Mi enfoque</p>
        <h3>Más que <span>escribir</span> código</h3>
        <p class="why__description">
          Descubre cómo desarrollo soluciones enfocadas en calidad, escalabilidad y resultados.
        </p>
      </header>

      <div class="approach" data-approach role="region" aria-label="Mi proceso de trabajo. Usa las flechas arriba y abajo para explorar." tabindex="0" style={`--steps: ${Math.max(0, approachSteps.length - 1)}`}>
        <div class="approach__stage">
          <div class="approach__cards">
            {approachSteps.map((step) => (
              <article class="approach__card" data-approach-card>
                <span class="approach__number grain-surface" aria-hidden="true">{step.icon}</span>
                <div>
                  <h4>{step.title}</h4>
                  <p>{step.description}</p>
                </div>
              </article>
            ))}
          </div>
          <nav class="approach__navigation" aria-label="Seleccionar paso" data-approach-navigation hidden>
            {approachSteps.map((step, index) => (
              <button type="button" aria-label={`${index + 1}. ${step.title}`} data-approach-button><span aria-hidden="true"></span></button>
            ))}
          </nav>
          <span class="approach__hint" aria-hidden="true">Desliza <span>↕</span></span>
          <span class="approach__status" role="status" aria-atomic="true" data-approach-status></span>
        </div>
        <div class="approach__space" aria-hidden="true"></div>
      </div>

      <div class="why__message">
        <span class="why__message-icon grain-surface" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <circle cx="12" cy="12" r="8" /><circle cx="12" cy="12" r="4" /><circle cx="12" cy="12" r="1" />
          </svg>
        </span>
        <p>El éxito de un proyecto no está en el <strong>código</strong>, sino en el <strong>impacto</strong> que genera.
          <strong>Ese es el objetivo detrás de cada solución que desarrollo.</strong>
        </p>
      </div>
    </div>
  </Container>
</section>

<script>
  import { initializeApproach } from "../features/approach/approach-animation";
  initializeApproach();
  document.addEventListener("astro:page-load", initializeApproach);
</script>

<style>
  .why {
    padding-block: var(--space-6);
    scroll-margin-top: 7rem;
  }
  .why__frame {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    background: #080808;
    padding-bottom: clamp(1.5rem, 4vw, 3rem);
  }
  .why__label {
    display: table;
    margin: 0;
    padding: var(--space-3) var(--space-6);
    border-top-left-radius: calc(var(--radius-medium) - 1px);
    background: #d4d4d8;
    color: #18181b;
    font: 600 0.875rem/1.6 var(--font-mono);
    text-transform: uppercase;
  }
  .why__intro {
    max-width: 48rem;
    margin: 2rem auto 0;
    padding-inline: 1.25rem;
    text-align: center;
    font-family: var(--font-mono);
  }
  .why__eyebrow {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
  }
  .why__intro h3 {
    margin: 0.25rem 0 0;
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    line-height: 1.35;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .why__intro h3 span, .why__message strong {
    color: var(--color-accent);
  }
  .why__description {
    margin: 0.875rem 0 0;
    color: #c4c4cc;
    font-size: clamp(0.875rem, 1.5vw, 1rem);
    line-height: 1.5;
    text-wrap: pretty;
  }
  .approach {
    --stage-height: 20rem;
    height: var(--stage-height);
    max-width: 48rem;
    margin: 0 auto;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior-y: auto;
    overflow-anchor: none;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
  }
  .approach:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -4px;
    border-radius: 0.5rem;
  }
  .approach__stage {
    position: relative;
    display: grid;
    align-content: center;
    min-height: var(--stage-height);
    padding: 3rem 3.25rem 3rem 1.25rem;
  }
  .approach__cards {
    display: grid;
    gap: 1rem;
    min-width: 0;
    isolation: isolate;
  }
  .approach__card {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    width: 100%;
    max-width: 28rem;
    min-width: 0;
    margin: 0 auto;
    padding: 1.125rem;
    border: 1px solid rgb(255 255 255 / 8%);
    border-radius: 0.625rem;
    background: #242424;
    box-shadow: 0 12px 28px rgb(0 0 0 / 20%);
  }
  .approach__card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: url("../assets/textures/grain.svg") repeat;
    background-size: 160px 160px;
    opacity: 0.14;
    pointer-events: none;
  }
  .approach__card > div {
    min-width: 0;
  }
  .approach__number {
    display: grid;
    place-items: center;
    flex: 0 0 2.5rem;
    height: 2.5rem;
    border-radius: 0.375rem;
    background: #d4d4d8;
    color: #18181b;
    font: 700 0.875rem var(--font-mono);
  }
  .approach__card h4 {
    margin: 0;
    font: 700 clamp(1rem, 2vw, 1.25rem)/1.3 var(--font-mono);
    overflow-wrap: anywhere;
  }
  .approach__card p {
    margin: 0.5rem 0 0;
    color: #c4c4cc;
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .approach__space, .approach__navigation[hidden], .approach__hint {
    display: none;
  }
  .approach[data-enhanced] .approach__stage {
    position: sticky;
    top: 0;
    height: var(--stage-height);
  }
  .approach[data-enhanced] .approach__cards {
    gap: 0;
  }
  .approach[data-enhanced] .approach__card {
    grid-area: 1 / 1;
  }
  .approach[data-enhanced] .approach__space {
    display: block;
    height: calc(var(--steps) * 480px);
  }
  .approach__navigation {
    position: absolute;
    right: 0.25rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    max-height: 80%;
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .approach__navigation button {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }
  .approach__navigation button:focus-visible {
    outline-offset: -5px;
  }
  .approach__navigation button span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #71717a;
  }
  .approach__navigation button[aria-current="step"] span {
    background: var(--color-accent);
    box-shadow: 0 0 0 4px rgb(147 197 253 / 10%);
  }
  .approach[data-enhanced] .approach__hint {
    display: block;
    position: absolute;
    bottom: 1.125rem;
    left: 0;
    right: 0;
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    pointer-events: none;
  }
  .approach__hint span {
    color: var(--color-accent);
    margin-left: 0.5rem;
  }
  .approach__status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .why__message {
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: 40rem;
    margin: 0 auto;
    width: calc(100% - 2.5rem);
    padding: 0.875rem 1rem;
    border: 1px solid var(--color-accent);
    border-radius: 1.25rem;
    background: #202124;
  }
  .why__message-icon {
    display: grid;
    place-items: center;
    flex: 0 0 2.5rem;
    height: 2.5rem;
    border-radius: 0.375rem;
    background: #d4d4d8;
    color: #18181b;
  }
  .why__message p {
    margin: 0;
    font: 0.75rem/1.6 var(--font-mono);
    color: #d4d4d8;
    text-wrap: pretty;
  }
  @media (min-width: 48rem) {
    .approach__stage {
      padding-inline: 5rem;
    }
    .approach__navigation {
      right: 1rem;
    }
  }
  @media (max-width: 25rem) {
    .approach {
      --stage-height: 23rem;
    }
    .approach__card {
      flex-direction: column;
    }
    .why__message {
      align-items: flex-start;
      gap: 0.75rem;
    }
  }
</style>
