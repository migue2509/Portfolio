---
import { Image } from "astro:assets";
import MainLayout from "../../layouts/MainLayout.astro";
import Container from "../../shared/layout/Container.astro";
import Footer from "../../shared/layout/Footer.astro";
import ResultGallery from "../../features/projects/ResultGallery.astro";
import ProjectText from "../../features/projects/ProjectText.astro";
import { projects } from "../../data/projects";
import { technologies } from "../../data/technologies";
import githubMark from "../../assets/brand/github-mark.svg";
import type { Project } from "../../features/projects/model/project";
import { existsSync } from "node:fs";

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
interface Props { project: Project; }
const { project } = Astro.props;
const challengeImage = project.challengeImage;
const documents = project.documents?.map((document) => ({
  ...document,
  href: `/documents/${project.slug}/${document.file}`,
  available: existsSync(`public/documents/${project.slug}/${document.file}`),
}));
const projectIndex = projects.findIndex((item) => item.slug === project.slug);
const nextProject = projects.length > 1 ? projects[(projectIndex + 1) % projects.length] : undefined;
const gallery = project.gallery.filter((image) => image.src.src !== project.cover.src.src);
const tools = project.tools ?? project.technologies.map((id) => technologies[id].name);
const catalog = Object.values(technologies);
const details = [
  { label: "Puesto", value: project.role },
  { label: "Categoría", value: project.category },
  { label: "Cliente", value: project.client },
];
---

<MainLayout title={`${project.title} | Miguel Ospina`} description={project.summary} showHeader={false}>
  <main id="inicio" tabindex="-1" class="project-detail">
    <Container>
      <article class="frame" aria-labelledby="project-title">
        <a class="back grain-surface" href="/#proyectos"><span aria-hidden="true">←</span> Volver</a>
        <header class="heading">
          <div class="intro">
            {(project.dateLabel || project.status) && <p class="meta">
              {project.dateLabel && <span>{project.dateLabel}</span>}
              {project.status && <span class="status">{project.status}</span>}
            </p>}
            <h1 id="project-title">{project.title}</h1>
            <div class="summary"><ProjectText text={project.introduction ?? project.summary} /></div>
            {project.tags?.length && <ul class="tags" aria-label="Tipo de proyecto">
              {project.tags.map((tag) => <li>{tag}</li>)}
            </ul>}
          </div>
          <aside class="info" aria-label="Ficha del proyecto">
            <dl>
              {details.filter((detail) => detail.value).map(({ label, value }) => (
                <div class="field"><dt>{label}</dt><dd>{value}</dd></div>
              ))}
              {tools.length > 0 && <div class="field">
                <dt>Herramientas</dt>
                <dd><ul class="tools">
                  {tools.map((name) => {
                    const technology = catalog.find((item) => item.name === name);
                    return <li>
                      {technology?.icon && <Image src={technology.icon} alt="" width={20} height={20} loading="lazy" />}
                      <span>{name}</span>
                    </li>;
                  })}
                </ul></dd>
              </div>}
              {project.team && <div class="field"><dt>Equipo</dt><dd>{project.team}</dd></div>}
            </dl>
            <div class="info-actions">
            {project.repositoryUrl ? <a class="code grain-surface" href={project.repositoryUrl} target="_blank" rel="noopener noreferrer">
              <img src={githubMark.src} width="16" height="16" alt="" />
              Ver código <span aria-hidden="true">↗</span><span class="sr-only"> (abre en otra pestaña)</span>
            </a> : <button class="code grain-surface" type="button" disabled title="Enlace al repositorio pendiente">
              <img src={githubMark.src} width="16" height="16" alt="" />
              Ver código <span aria-hidden="true">↗</span><span class="sr-only"> (enlace pendiente)</span>
            </button>}
            {project.liveUrl && <a class="code grain-surface" href={project.liveUrl} target="_blank" rel="noopener noreferrer">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2" /><path d="M8 21h8m-4-4v4" /></svg>
              Ver demo <span aria-hidden="true">↗</span><span class="sr-only"> (abre en otra pestaña)</span>
            </a>}
            </div>
          </aside>
        </header>
        <div class="cover-area">
          <figure>
            <Image src={project.cover.src} alt={project.cover.alt} widths={[480, 960, 1440]}
              sizes="(min-width: 64rem) 960px, 85vw" loading="eager" fetchpriority="high" class="project-image" />
          </figure>
        </div>
        <section class="detail-section" aria-labelledby="challenge-title">
          <h2 id="challenge-title">El reto</h2>
          {project.challengeTitle && <h3 class="challenge-subtitle">{project.challengeTitle}</h3>}
          {project.problem && <ProjectText text={project.problem} />}
          {project.problemAfterImage && <ProjectText text={project.problemAfterImage} />}
          {challengeImage && <figure class="section-image challenge-image">
            <Image src={challengeImage.src} alt={challengeImage.alt} widths={[480, 960, 1440]}
              sizes="(min-width: 48rem) 480px, 85vw" loading="lazy" class="project-image" />
          </figure>}
        </section>
        <section class="detail-section" aria-labelledby="solution-title">
          <h2 id="solution-title">La solución en acción</h2>
          {project.solution && <ProjectText text={project.solution} />}
          {project.solutionSteps?.length && <ol class="solution-flow" aria-label="Flujo de la operación">
            {project.solutionSteps.map((step) => <li>{step}</li>)}
          </ol>}
          {project.solutionAfterFlow && <ProjectText text={project.solutionAfterFlow} />}
        </section>
        <section class="detail-section" aria-labelledby="technical-title">
          <h2 id="technical-title">Decisiones y retos técnicos</h2>
          {project.technicalDecisions && <p>{project.technicalDecisions}</p>}
          {project.decisions?.map((decision) => <div class="technical-decision">
            <h3>{decision.title}</h3>
            <ProjectText text={decision.text} />
            {decision.images?.length && <div class="decision-images">
            {decision.images.map((image) => <figure>
              <Image src={image.src} alt={image.alt} widths={[480, 960, 1600]}
                sizes="(min-width: 48rem) 480px, 85vw" loading="lazy" class="project-image" />
            </figure>)}
            </div>}
          </div>)}
        </section>
        <section class="detail-section" aria-labelledby="learnings-title">
          <h2 id="learnings-title">Aprendizajes</h2>
          {project.learnings && <ProjectText text={project.learnings} />}
        </section>
        <section class="detail-section" aria-labelledby="result-title">
          <h2 id="result-title">Resultado y Galería</h2>
          {project.result && <ProjectText text={project.result} />}
          <ResultGallery images={gallery.length ? gallery : [project.cover]} />
        </section>
        {documents?.length && <section class="detail-section" aria-labelledby="documents-title">
          <h2 id="documents-title">Documentación y evidencia del proyecto</h2>
          <ul class="document-links">
            {documents.map((document) => <li>
              {document.available ? <a href={document.href} download>{document.label} <span aria-hidden="true">↓</span></a> : <span>{document.label} <small>— pendiente de archivo</small></span>}
            </li>)}
          </ul>
        </section>}
        <section class="detail-section" aria-labelledby="links-title">
          <h2 id="links-title">GitHub / Demo</h2>
          <div class="project-links">
            {project.repositoryUrl && <a class="code grain-surface" href={project.repositoryUrl} target="_blank" rel="noopener noreferrer">
              <img src={githubMark.src} width="16" height="16" alt="" />
              GitHub <span aria-hidden="true">↗</span><span class="sr-only"> (abre en otra pestaña)</span>
            </a>}
            {project.liveUrl && <a class="code grain-surface" href={project.liveUrl} target="_blank" rel="noopener noreferrer">
              Demo <span aria-hidden="true">↗</span><span class="sr-only"> (abre en otra pestaña)</span>
            </a>}
          </div>
        </section>
        <section class="detail-section" aria-labelledby="next-title">
          <h2 id="next-title">Siguiente proyecto</h2>
          {nextProject && <a class="next-project" href={`/proyectos/${nextProject.slug}/`}>
            {nextProject.title} <span aria-hidden="true">→</span>
          </a>}
        </section>
      </article>
    </Container>
  </main>
  <Footer />
</MainLayout>

<style>
  .project-detail { padding-block: var(--space-6) var(--space-8); }
  .frame {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    background: rgb(8 8 8 / 88%);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    min-height: 44px;
    padding: .5rem 1.25rem;
    color: #18181b;
    background: #d4d4d8;
    text-decoration: none;
  }
  .back span { font-size: 1.5rem; line-height: 1; }
  .heading {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(1.5rem, 3vw, 3rem);
    padding: var(--space-8) clamp(1.25rem, 5vw, 4rem) var(--space-12);
  }
  .intro { min-width: 0; }
  .meta { display: flex; flex-wrap: wrap; gap: .75rem; margin: 0 0 .75rem; color: var(--color-text-muted); font: .75rem var(--font-mono); }
  .status::before { content: ''; display: inline-block; width: .4rem; height: .4rem; margin-right: .4rem; border-radius: 50%; background: #39d353; }
  h1 { margin: 0; font-family: var(--font-mono); font-size: clamp(1.5rem, 3vw, 2.5rem); line-height: 1.15; text-transform: uppercase; overflow-wrap: anywhere; }
  .summary { max-width: 58ch; margin: var(--space-6) 0 0; color: var(--color-text-muted); }
  .tags { display: flex; flex-wrap: wrap; gap: .5rem; padding: 0; margin: var(--space-4) 0 0; list-style: none; }
  .tags li { padding: .2rem .8rem; border-radius: 999px; background: rgb(147 197 253 / 18%); color: var(--color-accent); font: .75rem var(--font-mono); text-transform: uppercase; }
  .info { min-width: 0; padding: 1.25rem; border: 1px solid var(--color-border); border-radius: 1.5rem; background: rgb(8 8 8 / 45%); }
  dl { margin: 0; }
  .field { padding-block: .5rem; border-bottom: 1px solid rgb(255 255 255 / 12%); }
  .field:first-child { padding-top: 0; }
  .field:last-child { border: 0; }
  dt { color: var(--color-text-muted); font: .7rem var(--font-mono); }
  dd { margin: .2rem 0 0; font: .875rem/1.5 var(--font-mono); overflow-wrap: anywhere; }
  .tools { display: flex; flex-wrap: wrap; gap: .6rem .8rem; padding: 0; margin: .5rem 0 0; list-style: none; }
  .tools li { display: flex; flex-direction: column; align-items: center; gap: .3rem; width: 4.5rem; text-align: center; font-size: .7rem; }
  .tools li:not(:has(img))::before { content: ''; height: 20px; }
  .tools img { flex-shrink: 0; object-fit: contain; }
  .code { display: flex; align-items: center; justify-content: center; gap: .5rem; width: fit-content; min-height: 44px; margin: 1.25rem auto 0; padding: .5rem .75rem; border-radius: .2rem; background: #d4d4d8; color: #18181b; text-decoration: none; font: .8rem var(--font-mono); }
  .cover-area { position: relative; isolation: isolate; padding: var(--space-8) clamp(1.25rem, 5vw, 4rem); border-block: 1px solid var(--color-border); }
  button.code { border: 0; }
  .info-actions { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: .5rem; margin-top: 1.25rem; }
  .info-actions .code { width: 100%; min-width: 0; margin: 0; padding: .5rem .375rem; gap: .3rem; font-size: .75rem; text-align: center; }
  .info-actions .code img, .info-actions .code svg { flex-shrink: 0; }
  .code:disabled { opacity: .65; cursor: not-allowed; }
  .cover-area::before { content: ''; position: absolute; z-index: -1; inset: 0 0 30%; border-radius: 0 0 2rem 9rem; background: #050505; }
  figure { max-width: 60rem; margin: 0 auto; overflow: hidden; border: 1px solid var(--color-border); border-radius: 1.25rem; background: #d4d4d8; }
  .project-image { display: block; width: 100%; height: auto; }
  .detail-section { padding: var(--space-8) clamp(1.25rem, 5vw, 4rem); }
  .detail-section + .detail-section { border-top: 1px solid var(--color-border); }
  .technical-decision { margin-top: var(--space-8); }
  .challenge-subtitle { margin: 0; color: var(--color-accent); font: 600 clamp(1.05rem, 1.5vw, 1.25rem)/1.45 var(--font-mono); text-wrap: balance; }
  .solution-flow { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem .75rem; max-width: 70ch; margin: var(--space-6) 0; padding: 0; list-style: none; font: .875rem/1.6 var(--font-mono); }
  .solution-flow li { display: flex; align-items: center; gap: .75rem; color: var(--color-accent); }
  .solution-flow li + li::before { content: '→'; color: var(--color-text-muted); }
  .document-links { display: grid; gap: var(--space-4); margin: 0; padding: 0; list-style: none; overflow-wrap: anywhere; }
  .document-links a { color: var(--color-accent); text-underline-offset: .25em; }
  .document-links small { color: var(--color-text-muted); }
  .decision-images { display: grid; gap: var(--space-4); max-width: 60rem; margin: var(--space-6) auto 0; }
  .decision-images figure { width: 100%; min-width: 0; }
  @media (min-width: 48rem) { .decision-images { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .technical-decision + .technical-decision { padding-top: var(--space-6); border-top: 1px solid rgb(255 255 255 / 8%); }
  .technical-decision h3 { margin: 0; color: var(--color-accent); font: 600 clamp(1.05rem, 1.5vw, 1.25rem)/1.45 var(--font-mono); text-wrap: balance; }
  .detail-section > h2 {
    margin: 0 0 var(--space-6);
    color: var(--color-text);
    font: 750 clamp(1.4rem, 2.5vw, 2rem)/1.25 var(--font-mono);
    letter-spacing: -.025em;
    text-wrap: balance;
  }
  .detail-section > h2::before {
    content: '';
    display: block;
    width: 2.75rem;
    height: 3px;
    margin-bottom: var(--space-3);
    background: var(--color-accent);
  }
  .detail-section p { max-width: 70ch; color: var(--color-text-muted); margin: var(--space-4) 0 0; white-space: pre-line; }
  .section-image { margin-top: var(--space-8); }
  .challenge-image { width: 100%; max-width: 30rem; margin-inline: auto; }
  .project-links { display: flex; flex-wrap: wrap; gap: var(--space-4); }
  .project-links .code { margin: var(--space-4) 0 0; }
  .next-project { display: inline-flex; align-items: center; gap: var(--space-4); min-height: 44px; margin-top: var(--space-4); color: var(--color-accent); font-family: var(--font-mono); text-underline-offset: .25em; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 47.99rem) {
    .heading { grid-template-columns: minmax(0, 1fr); }
    .info { border-radius: var(--radius-medium); }
  }
</style>
