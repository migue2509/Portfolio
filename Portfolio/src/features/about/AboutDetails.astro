---
import { Image } from "astro:assets";

import persistenciaIcon from "../../assets/about/persistencia.png";
import mentalidadIcon from "../../assets/about/mentalidad.png";
import responsabilidadIcon from "../../assets/about/responsabilidad.png";
import futuroIcon from "../../assets/about/orientacion-futuro.png";
import comunicacionIcon from "../../assets/about/comunicacion.png";
import productividadIcon from "../../assets/about/productividad.png";
import detalleIcon from "../../assets/about/orientacion-al-detalle.png";
import equipoIcon from "../../assets/about/trabajo-equipo.png";

const groups = [
  {
    title: "Mentalidad",
    items: [
      { label: "Persistencia", icon: persistenciaIcon },
      { label: "Mentalidad de crecimiento", icon: mentalidadIcon },
      { label: "Responsabilidad personal", icon: responsabilidadIcon },
      { label: "Orientación al futuro", icon: futuroIcon },
    ],
  },
  {
    title: "Habilidades de comportamiento",
    items: [
      { label: "Comunicación", icon: comunicacionIcon },
      { label: "Productividad", icon: productividadIcon },
      { label: "Orientación al detalle", icon: detalleIcon },
      { label: "Trabajo en equipo", icon: equipoIcon },
    ],
  },
];
---

<div class="about-details">
  <div class="about-details__introduction">
    <h3 class="about-details__title">Tu Desarrollador</h3>

    <div class="about-details__description">
      <p>
        Me gusta aprender construyendo y enfrentar proyectos que me obliguen 
        a entender cómo funciona cada parte de una solución.
      </p>

      <p>
         He orientado mi perfil hacia el desarrollo Full Stack, con especial
         interés en el backend, la lógica de negocio y la construcción de aplicaciones 
         que conecten tecnología con necesidades reales.
      </p>
    </div>
  </div>

  {
    groups.map((group) => (
      <div class="about-details__group">
        <h4 class="about-details__subtitle">
          <span aria-hidden="true">// </span>
          {group.title}
        </h4>

        <ul class="about-details__tags" role="list">
          {group.items.map((item) => (
  <li class="about-details__tag">
    <Image
      src={item.icon}
      alt=""
      width={16}
      height={16}
      fit="contain"
      densities={[1, 2]}
      loading="lazy"
      class="about-details__icon"
    />
    <span>{item.label}</span>
  </li>
))}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .about-details {
    min-width: 0;
    border: 1px solid var(--color-border);
    background-color: rgb(9 9 11 / 85%);
  }

  .about-details__title {
    margin: 0;
    padding: var(--space-4);

    background: linear-gradient(
      110deg,
      #27272a,
      var(--color-surface)
    );

    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 800;
    line-height: 1.4;
  }

  .about-details__description {
    padding: var(--space-4);
    color: var(--color-text-muted);
  }

  .about-details__description p {
    margin: 0;
  }

  .about-details__description p + p {
    margin-top: var(--space-4);
  }

  .about-details__group {
    padding: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .about-details__subtitle {
    margin: 0 0 var(--space-3);

    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
  }

.about-details__tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);

  margin: 0;
  padding: 0;
  list-style: none;
}


.about-details__tag {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);

  max-width: 100%;
  padding: var(--space-1) var(--space-2);

  border: 1px solid var(--color-border);
  border-radius: 0.25rem;
  background-color: var(--color-surface);

  font-family: var(--font-mono);
  font-size: 0.875rem;
  overflow-wrap: anywhere;
}

  .about-details__icon {
  width: 1rem;
  height: 1rem;
  flex-shrink: 0;
  object-fit: contain;
}

.about-details__tag > span {
  min-width: 0;
}
</style>