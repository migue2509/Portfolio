---
import { Image } from "astro:assets";
import portrait from "../../assets/profile/icon.png";
---

<article class="profile-card" aria-labelledby="profile-name">
  <div class="profile-card__surface">
    <div class="profile-card__portrait">
      <Image
        src={portrait}
        alt="Retrato de Miguel Ospina"
        class="profile-card__image"
        widths={[192, 384, portrait.width]}
        sizes="192px"
        loading="lazy"
      />
    </div>

    <div class="profile-card__information">
      <p class="profile-card__location">
        Medellín, Colombia
      </p>

      <h3 id="profile-name" class="profile-card__name">
        Miguel Ospina
      </h3>

      <p class="profile-card__username">
        @migue2509
      </p>

      <p class="profile-card__availability">
        <span class="profile-card__dot" aria-hidden="true"></span>
        Disponible
      </p>
    </div>
  </div>
</article>

<style>
  .profile-card {
    display: grid;
    place-items: center;
    min-width: 0;
    padding: var(--space-6);

    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);

    background-image:
      linear-gradient(
        90deg,
        transparent calc(50% - 0.5px),
        var(--color-border) 50%,
        transparent calc(50% + 0.5px)
      ),
      linear-gradient(
        transparent calc(50% - 0.5px),
        var(--color-border) 50%,
        transparent calc(50% + 0.5px)
      );
  }

  .profile-card__surface {
    width: 100%;
    max-width: 20rem;
    padding: var(--space-6) var(--space-4);

    border: 1px solid rgb(255 255 255 / 4%);
    border-radius: var(--radius-small);
    background: linear-gradient(
      145deg,
      rgb(255 255 255 / 6%),
      rgb(255 255 255 / 2%)
    );

    text-align: center;
  }

  .profile-card__portrait {
    width: 100%;
    max-width: 12rem;
    aspect-ratio: 1;
    margin-inline: auto;
  }

  .profile-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .profile-card__information {
    margin-top: var(--space-6);
    font-family: var(--font-mono);
  }

  .profile-card__location {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .profile-card__name {
    margin: var(--space-2) 0 0;

    font-size: 1.125rem;
    font-weight: 800;
    line-height: 1.4;
  }

  .profile-card__username {
    margin: var(--space-2) 0 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .profile-card__availability {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);

    margin: var(--space-4) 0 0;
    padding: var(--space-1) var(--space-3);

    border-radius: 999px;
    background-color: rgb(34 197 94 / 12%);
    color: #86efac;
    font-size: 0.875rem;
  }

  .profile-card__dot {
    width: 0.5rem;
    height: 0.5rem;
    flex-shrink: 0;

    border-radius: 50%;
    background-color: #22c55e;
  }
</style>